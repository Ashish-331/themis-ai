# AWS Region & Bedrock Region
AWS_REGION=ap-south-1
BEDROCK_REGION=us-east-1

# DynamoDB & S3 Resources
DOCUMENTS_TABLE=themis-documents
BUCKET_NAME=themis-documents-local

# AI Model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Real AWS Credentials for Live Bedrock Vision
# (Leave empty to use local offline heuristic knowledge base)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito Auth (set in real cloud deployment)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Local development toggle
IS_LOCAL=true
